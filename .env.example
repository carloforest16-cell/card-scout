# Copier ce fichier vers .env.local et remplir les valeurs réelles.
# Ne jamais committer .env.local dans git.

# eBay OAuth (client_credentials flow) — https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# DeepSeek API — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron — Bearer token protégeant /api/cron/* (choisir une valeur aléatoire longue)
CRON_SECRET=

# Admin dashboard (/admin) — mot de passe fort
ADMIN_PASSWORD=

# URL publique (pour les appels internes depuis crons)
# Local : http://localhost:3001  |  Prod : https://cardmetrics.io
NEXT_PUBLIC_SITE_URL=

# Resend — emails transactionnels — https://resend.com
RESEND_API_KEY=
RESEND_FROM=Card Metrics <onboarding@resend.dev>

# Adresse email qui reçoit les alertes health-check quotidiennes
ADMIN_ALERT_EMAIL=

# Test login (dev/staging uniquement — NE PAS activer en prod)
# NEXT_PUBLIC_ALLOW_TEST_LOGIN=1
